# 复制为 .env 后填入真实值（.env 已被 gitignore，勿提交）

# 评审口令：提交 GitHub issue 的防刷口令，前端「评审口令」输入框需填入相同值
REVIEW_SECRET=

# GitHub Personal Access Token：/api/issue 用它调 GitHub API 创建 issue
# 需要 repo 写权限（public_repo）
GITHUB_TOKEN=

# 可选：目标仓库，默认 wenliang-xiao/dive-into-agent-harness
# GITHUB_REPO=wenliang-xiao/dive-into-agent-harness
