    { "id": "p2", "label": "测量", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "p3", "label": "裁决", "fromCol": 3, "toCol": 4 }
  ],
  "mainPath": ["corpus", "run", "measure", "assert", "report"],
  "nodes": [
    { "id": "corpus", "lane": "bench", "col": 0, "type": "backend", "label": "合成输入", "sublabel": "固定常量生成", "width": 132 },
    { "id": "run", "lane": "bench", "col": 1, "type": "backend", "label": "跑 benchmark", "sublabel": "用户路径", "width": 140 },
    { "id": "measure", "lane": "bench", "col": 2, "type": "backend", "label": "计时 + 内存", "sublabel": "中位数 + 峰值 RSS", "width": 150 },
    { "id": "assert", "lane": "bench", "col": 3, "type": "security", "label": "断言预算", "sublabel": "median < BUDGET", "width": 140 },
    { "id": "report", "lane": "bench", "col": 4, "type": "backend", "label": "报告", "sublabel": "防性能回退", "width": 132 },
    { "id": "fix", "lane": "fix", "col": 3, "type": "security", "label": "修复性能", "sublabel": "超预算", "width": 132 }
  ],
  "edges": [
    { "id": "e1", "from": "corpus", "to": "run", "variant": "default" },
    { "id": "e2", "from": "run", "to": "measure", "variant": "default" },
    { "id": "e3", "from": "measure", "to": "assert", "variant": "default" },
    { "id": "e4", "from": "assert", "to": "report", "label": "通过", "variant": "emphasis" },
    { "id": "e5", "from": "assert", "to": "fix", "label": "超预算", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "三大原则",
      "items": [
        "按用户路径组织（测用户感知，不是内部函数）",
        "合成输入保证可复现，预算断言防回退"
      ]
    }
  ]
