    { "id": "model", "type": "decision", "label": "模型判断", "sublabel": "要调工具吗？", "lane": "main", "col": 1, "step": "02", "tag": "check", "width": 132 },
    { "id": "validate", "type": "active", "label": "参数校验", "sublabel": "validateArguments", "lane": "main", "col": 2, "step": "03", "tag": "work", "width": 140 },
    { "id": "execute", "type": "active", "label": "执行工具", "sublabel": "tool.execute", "lane": "main", "col": 3, "step": "04", "tag": "work", "width": 132 },
    { "id": "feedback", "type": "active", "label": "结果回传", "sublabel": "tool 消息 + id", "lane": "main", "col": 4, "step": "05", "tag": "work", "width": 140 },
    { "id": "answer", "type": "success", "label": "返回答案", "sublabel": "无工具调用", "lane": "exit", "col": 1, "step": "06", "tag": "done", "width": 132 }
