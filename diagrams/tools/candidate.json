    { "id": "t5", "from": "feedback", "to": "model", "label": "循环", "variant": "emphasis", "route": "top-channel" },
    { "id": "t6", "from": "model", "to": "answer", "label": "无工具·结束", "variant": "default", "route": "drop" }
  ],
  "cards": [
    {
